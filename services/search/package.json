{
  "name": "@auto-world/search",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": ["dist"],
  "exports": {
    "./prototype": {
      "auto-world-prototype": {
        "types": "./.prototype-dist/index.d.ts",
        "import": "./.prototype-dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "pnpm --filter @auto-world/connector-sdk build && pnpm --filter @auto-world/demo-search-contract build && tsc -p tsconfig.json && tsc -p tsconfig.prototype.json",
    "lint": "eslint src prototype test --max-warnings=0",
    "typecheck": "pnpm --filter @auto-world/connector-sdk build && pnpm --filter @auto-world/demo-search-contract build && tsc -p tsconfig.json --noEmit && tsc -p tsconfig.prototype.json --noEmit",
    "test": "pnpm run build && node --conditions=auto-world-prototype --conditions=auto-world-demo --test test/*.test.mjs"
  },
  "devDependencies": {
    "@auto-world/api": "workspace:*",
    "@auto-world/connector-sdk": "workspace:*",
    "@auto-world/demo-search-contract": "workspace:*",
    "@auto-world/ingestion": "workspace:*",
    "@auto-world/synthetic-connector": "workspace:*",
    "@auto-world/vehicle-schema": "workspace:*",
    "@types/node": "22.20.2",
    "@types/pg": "8.23.1",
    "pg": "8.23.1"
  }
}
