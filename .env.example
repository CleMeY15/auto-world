NODE_ENV=development
# Non-secret connection coordinates only; never a production configuration.
# pnpm infra:init generates separate local credentials in ignored .local-data/.
# The infra CLI uses its explicit generated env file, not this root .env.
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=autoworld
PGUSER=aw_reader
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
OPENSEARCH_URL=http://127.0.0.1:9200
S3_ENDPOINT=http://127.0.0.1:9000
S3_BUCKET=aw-raw
