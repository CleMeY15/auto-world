+// Fixtures installs the exact locked repository archive without network access.
+func Fixtures() error {
+	_, filePath, _, _ := runtime.Caller(0)
+	dir := filepath.Dir(filePath)
+	manifest, err := loadManifest(dir)
+	if err != nil {
+		return err
+	}
+	archive := filepath.Join(dir, filepath.FromSlash(manifest.Git.ArchivePath))
+	archiveHandle, err := openVerifiedFile(archive, manifest.Git.ArchiveSHA256, manifest.Git.ArchiveSize)
+	if err != nil {
+		return xerrors.Errorf("verify Git fixture archive: %w", err)
+	}
+	defer archiveHandle.Close()
+	temporary, err := os.MkdirTemp(dir, ".test-repo-fixture-")
+	if err != nil {
+		return err
+	}
+	defer os.RemoveAll(temporary)
+	if err = extractRepository(archiveHandle, temporary); err != nil {
+		return xerrors.Errorf("extract Git fixture archive: %w", err)
+	}
+	extracted := filepath.Join(temporary, repoDir)
+	if err = verifyRepository(extracted); err != nil {
+		return xerrors.Errorf("verify Git fixture repository: %w", err)
+	}
+	destination := filepath.Join(dir, repoDir)
+	backup := filepath.Join(temporary, "previous")
+	hadPrevious := false
+	if _, err = os.Lstat(destination); err == nil {
+		if err = os.Rename(destination, backup); err != nil {
+			return err
+		}
+		hadPrevious = true
+	} else if !errors.Is(err, os.ErrNotExist) {
+		return err
+	}
+	if err = os.Rename(extracted, destination); err != nil {
+		if hadPrevious {
+			if restoreErr := os.Rename(backup, destination); restoreErr != nil {
+				return xerrors.Errorf("install Git fixture failed (%v); restore previous fixture: %w", err, restoreErr)
+			}
+		}
+		return err
+	}
 	return nil
