+func openVerifiedFile(file, expectedSHA256 string, expectedSize int64) (*os.File, error) {
+	pathInfo, err := os.Lstat(file)
+	if err != nil {
+		return nil, err
+	}
+	if !pathInfo.Mode().IsRegular() {
+		return nil, errors.New("fixture material type mismatch")
+	}
+	handle, err := os.Open(file)
+	if err != nil {
+		return nil, err
+	}
+	info, err := handle.Stat()
+	if err != nil {
+		handle.Close()
+		return nil, err
+	}
+	if !info.Mode().IsRegular() || !os.SameFile(pathInfo, info) || info.Size() != expectedSize {
+		handle.Close()
+		return nil, errors.New("fixture material size or type mismatch")
+	}
+	hash := sha256.New()
+	if _, err = io.Copy(hash, handle); err != nil {
+		handle.Close()
+		return nil, err
+	}
+	if hex.EncodeToString(hash.Sum(nil)) != expectedSHA256 {
+		handle.Close()
+		return nil, errors.New("fixture material SHA-256 mismatch")
+	}
+	if _, err = handle.Seek(0, io.SeekStart); err != nil {
+		handle.Close()
+		return nil, err
+	}
+	return handle, nil
+}
