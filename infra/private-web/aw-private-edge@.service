[Unit]
Description=Auto World private HTTPS entry
Requires=aw-private-auth.service aw-private-product.service
After=aw-private-auth.service aw-private-product.service network.target
[Service]
User=aw-private-edge
Group=aw-private-edge
SupplementaryGroups=aw-private-product aw-private-auth
RuntimeDirectory=aw-private-edge-%i
RuntimeDirectoryMode=0700
UMask=0077
LoadCredential=tls-key:/etc/aw-private-web/privkey.pem
ExecStartPre=/opt/aw-private-web/render-edge %i
ExecStartPre=/opt/aw-private-web/bin/nginx -t -p /run/aw-private-edge-%i -c /run/aw-private-edge-%i/nginx.conf
ExecStartPre=/opt/aw-private-web/preflight.sh
ExecStart=/opt/aw-private-web/bin/nginx -p /run/aw-private-edge-%i -c /run/aw-private-edge-%i/nginx.conf
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
[Install]
WantedBy=multi-user.target
