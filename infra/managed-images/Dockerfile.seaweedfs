# Managed diagnostic derivative. Source, builder and base identities are immutable.
FROM golang@sha256:bff16a94c0b4b6d9642581e2a3aa81beb3edb940b2f5a3aac1d22c6a68cb7747 AS weed-build

ENV GOENV=off GOTOOLCHAIN=local GOWORK=off CGO_ENABLED=0 GOOS=linux GOARCH=amd64 \
    GOPROXY=https://proxy.golang.org GOSUMDB=sum.golang.org \
    GOPRIVATE= GONOPROXY= GONOSUMDB= GOFLAGS= \
    GOMODCACHE=/go/pkg/mod GOCACHE=/tmp/seaweedfs-build-cache
WORKDIR /src/seaweedfs
COPY infra/managed-images/seaweedfs/ /materials/
ADD --checksum=sha256:d650e7a8a2cbec8a1725386f87f5eb803c95aa84417530aec58c1925fd23a2c9 https://codeload.github.com/seaweedfs/seaweedfs/tar.gz/ffa87c25fdf587178b1521ad87f2a4a72a02e584 /tmp/seaweedfs-source.tar.gz
RUN /bin/sh /materials/prepare-source.sh

# Failed upstream tests or compilation remain exportable through target evidence.
# The runtime target below independently requires every status to be zero.
RUN --network=none /bin/sh /materials/run-normal-profile.sh

FROM chrislusf/seaweedfs@sha256:3a522c379599e163433a636e75022630848b63a74f08ea37bf06f8d776e9a707 AS seaweedfs-base

FROM scratch AS evidence
COPY --from=weed-build /out/evidence/ /

FROM seaweedfs-base AS runtime
COPY --from=weed-build --chown=0:0 --chmod=0755 /out/weed /usr/bin/weed
COPY --from=weed-build --chown=0:0 /out/evidence/licenses/ /usr/share/licenses/auto-world-seaweedfs/
COPY --from=weed-build --chown=0:0 /out/evidence/DERIVATIVE-NOTICE.txt /usr/share/licenses/auto-world-seaweedfs/DERIVATIVE-NOTICE.txt
LABEL org.opencontainers.image.source="https://github.com/CleMeY15/auto-world" \
      io.auto-world.seaweedfs.component="auto-world-seaweedfs/4.51-ffa87c2-aw-go-5b789254" \
      io.auto-world.seaweedfs.source="https://github.com/seaweedfs/seaweedfs/commit/ffa87c25fdf587178b1521ad87f2a4a72a02e584" \
      io.auto-world.seaweedfs.patch-go-mod-sha256="5b7892540b197eb5156333ffc9ae108084849db07d0dea57b7060339f840a1a9" \
      io.auto-world.seaweedfs.authority="diagnostic-only-not-admitted"
RUN --network=none --mount=type=bind,from=weed-build,source=/out,target=/tmp/weed-build,readonly set -eu; \
    test "$(cat /tmp/weed-build/evidence/preparation.exit-code)" = 0; \
    test "$(cat /tmp/weed-build/evidence/package-list.exit-code)" = 0; \
    test "$(cat /tmp/weed-build/evidence/go-test.exit-code)" = 0; \
    test "$(cat /tmp/weed-build/evidence/go-test-capture.exit-code)" = 0; \
    test "$(cat /tmp/weed-build/evidence/build.exit-code)" = 0; \
    test "$(cat /tmp/weed-build/evidence/build-validation.exit-code)" = 0; \
    test "$(cat /tmp/weed-build/evidence/go-test-stream.tsv)" = "$(cat /tmp/weed-build/evidence/go-test-concat.tsv)"; \
    cmp /usr/bin/weed /tmp/weed-build/weed; \
    test "$(stat -c '%u:%g:%a' /usr/bin/weed)" = '0:0:755'; \
    test -s /usr/share/licenses/auto-world-seaweedfs/DERIVATIVE-NOTICE.txt
