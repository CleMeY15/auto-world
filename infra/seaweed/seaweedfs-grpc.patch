+func TestDiskStateSnapshotRestoresIndependentProtoState(t *testing.T) {
+	unknown := []byte{0xf8, 0x07, 0x01}
+	source := &volume_server_pb.DiskStatus{
+		Dir:         "/baseline",
+		All:         100,
+		Used:        40,
+		Free:        60,
+		PercentFree: 60,
+		PercentUsed: 40,
+		DiskType:    "ssd",
+	}
+	source.ProtoReflect().SetUnknown(append([]byte(nil), unknown...))
+	state := &diskState{}
+	state.rememberGoodStatusLocked(source)
+	source.All = 999
+	source.ProtoReflect().SetUnknown([]byte{0xf8, 0x07, 0x02})
+
+	first := &volume_server_pb.DiskStatus{Dir: "/current"}
+	state.applyLastGoodStatusLocked(first)
+	if first.Dir != "/current" || first.Error != "" || first.All != 100 || first.DiskType != "ssd" {
+		t.Fatalf("unexpected restored disk status: %+v", first)
+	}
+	if !bytes.Equal(first.ProtoReflect().GetUnknown(), unknown) {
+		t.Fatalf("unknown fields were not restored: %x", first.ProtoReflect().GetUnknown())
+	}
+	first.All = 777
+	first.ProtoReflect().GetUnknown()[2] = 0x03
+
+	second := &volume_server_pb.DiskStatus{Dir: "/second"}
+	state.applyLastGoodStatusLocked(second)
+	if second.Dir != "/second" || second.All != 100 || !bytes.Equal(second.ProtoReflect().GetUnknown(), unknown) {
+		t.Fatalf("snapshot was aliased by first restore: %+v unknown=%x", second, second.ProtoReflect().GetUnknown())
+	}
+
+	guarded := &volume_server_pb.DiskStatus{Dir: "/guarded", All: 5, Error: "probe failed"}
+	guardedBefore := proto.Clone(guarded).(*volume_server_pb.DiskStatus)
+	state.applyLastGoodStatusLocked(guarded)
+	if !proto.Equal(guarded, guardedBefore) {
+		t.Fatalf("error guard did not preserve current status: got=%v want=%v", guarded, guardedBefore)
+	}
+
+	emptyState := &diskState{}
+	uninitialized := &volume_server_pb.DiskStatus{Dir: "/uninitialized", All: 7}
+	emptyState.applyLastGoodStatusLocked(uninitialized)
+	if uninitialized.All != 7 || uninitialized.Dir != "/uninitialized" {
+		t.Fatalf("uninitialized snapshot guard mutated status: %+v", uninitialized)
+	}
+}
