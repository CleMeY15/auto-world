{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    ".npmrc",
    ".nvmrc",
    "eslint.config.mjs",
    "package.json",
    "pnpm-lock.yaml",
    "scripts/**",
    "tsconfig.base.json"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**"]
    },
    "lint": {
      "dependsOn": ["^lint"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^typecheck", "^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
