{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "declaration": false,
    "noEmit": true,
    "jsx": "react-jsx",
    "lib": ["dom", "dom.iterable", "esnext"],
    "skipLibCheck": true,
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "types": ["node"]
  },
  "include": ["next-env.d.ts", "src/**/*.ts", "src/**/*.tsx", ".next/types/**/*.ts", ".next/dev/types/**/*.ts", "playwright.config.ts", "test/**/*.ts"],
  "exclude": ["node_modules"]
}
