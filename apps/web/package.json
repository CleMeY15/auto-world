{
  "name": "@auto-world/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "dev": "next dev --hostname 127.0.0.1",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint src test next.config.mjs playwright.config.ts --max-warnings=0",
    "typecheck": "next typegen && tsc -p tsconfig.json --noEmit",
