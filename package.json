{
  "name": "auto-world",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": "22.23.2",
    "pnpm": "10.15.0"
  },
  "scripts": {
    "build": "turbo run build --concurrency=2",
    "dev": "turbo run dev --parallel",
    "lint": "eslint eslint.config.mjs scripts tests --max-warnings=0 && turbo run lint --concurrency=2",
    "typecheck": "turbo run typecheck --concurrency=2",
    "test": "node --test tests/*.test.mjs && turbo run test --concurrency=2",
    "secrets:check": "node scripts/check-secrets.mjs",
    "audit:dependencies": "pnpm audit --audit-level low",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build && pnpm run secrets:check && pnpm run audit:dependencies",
    "infra:init": "node scripts/data-infra/cli.mjs init",
    "infra:up": "node scripts/data-infra/cli.mjs up",
    "infra:status": "node scripts/data-infra/cli.mjs status",
    "infra:migrate": "node scripts/data-infra/cli.mjs migrate",
    "infra:stop": "node scripts/data-infra/cli.mjs stop",
    "infra:start": "node scripts/data-infra/cli.mjs start",
    "infra:down": "node scripts/data-infra/cli.mjs down",
    "infra:reset": "node scripts/data-infra/cli.mjs reset",
    "infra:backup": "node scripts/data-infra/cli.mjs backup",
    "infra:restore-check": "node scripts/data-infra/cli.mjs restore-check",
    "infra:test": "pnpm --filter @auto-world/source-registry... build && node scripts/data-infra/integration.mjs",
    "infra:audit": "node scripts/data-infra/audit.mjs"
  },
  "devDependencies": {
    "@auto-world/source-registry": "workspace:*",
    "@auto-world/vehicle-schema": "workspace:*",
    "@eslint/js": "10.0.1",
    "@secretlint/secretlint-rule-preset-recommend": "13.0.5",
    "eslint": "10.10.0",
    "secretlint": "13.0.5",
    "turbo": "2.10.12",
    "typescript": "5.9.2",
    "typescript-eslint": "8.69.0"
  }
}
