{
  "name": "@auto-world/connector-sdk",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" }
  },
  "scripts": {
    "build": "pnpm --filter @auto-world/source-registry build && tsc -p tsconfig.json",
    "lint": "eslint src test --max-warnings=0",
    "typecheck": "pnpm --filter @auto-world/source-registry build && tsc -p tsconfig.test.json --noEmit",
    "test": "pnpm run build && node --test test/*.test.mjs"
  },
  "dependencies": {
    "@auto-world/source-registry": "workspace:*",
    "@auto-world/vehicle-schema": "workspace:*"
  }
}
