+#[derive(Clone, Debug, serde::Serialize)]
+pub struct SalePriceEvidence {
+    schema: &'static str,
+    list_id: String,
+    currency: &'static str,
+    pub amount_minor: u64,
+}
+
+pub(crate) fn evidence(
+    prices: &HashMap<String, Option<u64>>,
+    listing_url: &str,
+) -> Option<SalePriceEvidence> {
+    let url = url::Url::parse(listing_url).ok()?;
+    let id = crate::scraper::listing_id(&url)?;
+    let euros = prices.get(id).copied().flatten()?;
+    let cents = euros.checked_mul(100).filter(|n| *n <= 9_007_199_254_740_991)?;
+    Some(SalePriceEvidence {
+        schema: "searchData.ads.offer.price/v1",
+        list_id: id.to_owned(),
+        currency: "EUR",
+        amount_minor: cents,
+    })
+}
