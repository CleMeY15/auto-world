+use serde_json::{Map, Value};
+use std::collections::HashSet;
+
+// Only source codes and labels whose meaning agrees may leave the raw export.
+pub(crate) fn from_offer(ad: &Value) -> Option<Map<String, Value>> {
+    if ad.get("ad_type")?.as_str()? != "offer" {
+        return None;
+    }
+    let mut features = Map::new();
+    let mut seen = HashSet::new();
+    for attr in ad.get("attributes")?.as_array()? {
+        let key = attr.get("key")?.as_str()?;
+        let (name, key_label) = match key {
+            "fuel" => ("fuel", "Énergie"),
+            "gearbox" => ("gearbox", "Boîte de vitesse"),
+            "vehicle_type" => ("body", "Type de véhicule"),
+            "vehicule_color" => ("color", "Couleur"),
+            "vehicle_upholstery" => ("upholstery", "Sellerie"),
+            "doors" => ("doors", "Nombre de portes"),
+            "seats" => ("seats", "Nombre de place(s)"),
+            "vehicle_history" => ("firstOwner", "Historique du véhicule"),
+            "vehicle_technical_inspection_valid" => {
+                ("inspectionValid", "Contrôle technique valide")
+            }
+            "vehicle_maintenance" => ("serviceBook", "Entretien du véhicule"),
+            _ => continue,
+        };
+        if !seen.insert(key) {
+            features.remove(name);
+            continue;
+        }
+        if attr.get("key_label").and_then(Value::as_str) == Some(key_label) {
+            if let Some(value) = feature_value(name, attr) {
+                features.insert(name.to_owned(), value);
+            }
+        }
+    }
+    (!features.is_empty()).then_some(features)
+}
+
+// These source fields name the vehicle on a specific offer. The make and model must
+// both match the compiled catalogue vocabulary, including multiword model names.
+pub(crate) fn canonical_model(offer: &Value) -> Option<(String, String)> {
+    use std::collections::HashMap;
+    use std::sync::OnceLock;
+    static LABELS: OnceLock<HashMap<String, Vec<String>>> = OnceLock::new();
+    if offer.get("ad_type")?.as_str()? != "offer" {
+        return None;
+    }
+    let attrs = offer.get("attributes")?.as_array()?;
+    let (mut brand, mut model, mut brand_alias, mut model_alias) = (None, None, None, None);
+    for attr in attrs {
+        let (slot, label) = match attr.get("key")?.as_str()? {
+            "brand" => (&mut brand, "Marque"),
+            "model" => (&mut model, "Modèle"),
+            "u_car_brand" => (&mut brand_alias, "Marque"),
+            "u_car_model" => (&mut model_alias, "Modèle"),
+            _ => continue,
+        };
+        if slot.replace(attr).is_some() || attr.get("key_label")?.as_str()? != label {
+            return None;
+        }
+    }
+    let (brand, brand_code, brand_codes) = model_attribute(brand?)?;
+    let (model, model_code, model_codes) = model_attribute(model?)?;
+    if brand != brand_code || brand_codes.len() != 1 || model != model_code {
+        return None;
+    }
+    match &model_codes[1..] {
+        [] => (),
+        [class] if class.as_str() == Some("model_all") => (),
+        _ => return None,
+    }
+    let make = folded_brand(brand);
+    let model_key = model.to_lowercase();
+    let brand_alias_code = if let Some(attr) = brand_alias {
+        let (label, code, codes) = model_attribute(attr)?;
+        if codes.len() != 1
+            || label.to_lowercase() != code.to_lowercase()
+            || !same_brand(code, &make)
+        {
+            return None;
+        }
+        Some(code)
+    } else {
+        None
+    };
+    if let Some(attr) = model_alias {
+        let (label, code, codes) = model_attribute(attr)?;
+        let (alias_brand, alias_model) = code.split_once('_')?;
+        if label.to_lowercase() != model_key
+            || alias_model.to_lowercase() != model_key
+            || !same_brand(alias_brand, &make)
+            || brand_alias_code.is_some_and(|expected| alias_brand != expected)
+            || codes.len() != model_codes.len()
+        {
+            return None;
+        }
+        if let Some(second) = codes.get(1) {
+            if second.as_str()? != format!("{alias_brand}_model_all") {
+                return None;
+            }
+        }
+    }
+    let labels = LABELS.get_or_init(|| {
+        serde_json::from_str(include_str!("../vehicle_labels_v2.json"))
+            .expect("invalid compiled vehicle vocabulary")
+    });
+    let (canonical, models) = labels
+        .iter()
+        .find(|(label, _)| folded_brand(label) == make)?;
+    let model = models
+        .iter()
+        .find(|label| label.to_lowercase() == model_key)?;
+    Some((canonical.clone(), model.clone()))
+}
+
+// Both representations of the source code must agree before it can corroborate a label.
+fn model_attribute(attr: &Value) -> Option<(&str, &str, &[Value])> {
+    let label = attr.get("value_label")?.as_str()?;
+    let code = attr.get("value")?.as_str()?;
+    let codes = attr.get("values")?.as_array()?;
+    (codes.first()?.as_str()? == code).then_some((label, code, codes.as_slice()))
+}
+
+fn folded_brand(label: &str) -> String {
+    let lower = label.to_lowercase();
+    match lower.as_str() {
+        "citroen" => "citroën".to_owned(),
+        "skoda" => "škoda".to_owned(),
+        _ => lower,
+    }
+}
+
+fn same_brand(code: &str, make: &str) -> bool {
+    let normalized = folded_brand(code);
+    normalized == make
+        || matches!(
+            (normalized.as_str(), make),
+            ("mercedes", "mercedes-benz") | ("mercedes-benz", "mercedes")
+        )
+}
+
+fn feature_value(name: &str, attr: &Value) -> Option<Value> {
+    let codes = attr.get("values")?.as_array()?;
+    let label = attr.get("value_label")?.as_str()?;
+    // LBC leaves the scalar empty for list-valued fields (including upholstery).
+    if let Some(value) = attr.get("value") {
+        let scalar = value.as_str()?;
+        if !scalar.is_empty() && (codes.len() != 1 || codes[0].as_str() != Some(scalar)) {
+            return None;
+        }
+    }
+    if name == "firstOwner" {
+        return listed_option(
+            codes,
+            label,
+            "first_hand_vehicle",
+            &[
+                ("first_hand_vehicle", "Première main"),
+                ("imported_vehicle", "Véhicule importé"),
+            ],
+        );
+    }
+    if name == "serviceBook" {
+        return listed_option(
+            codes,
+            label,
+            "maintenance_booklet_available",
+            &[
+                (
+                    "maintenance_booklet_available",
+                    "Carnet d'entretien disponible",
+                ),
+                ("available_invoices", "Factures disponibles"),
+                ("nonsmoking_vehicle", "Véhicule non fumeur"),
+                ("useful_repairs_done", "Réparations utiles déjà faites"),
+            ],
+        );
+    }
+    let [code] = codes.as_slice() else {
+        return None;
+    };
+    let code = code.as_str()?;
+    if name == "doors" || name == "seats" {
+        if let [digit @ b'1'..=b'9'] = label.as_bytes() {
+            return (code == label).then(|| Value::from(digit - b'0'));
+        }
+        return None;
+    }
+    if name == "inspectionValid" {
+        return match (code, label) {
+            ("true", "Oui") => Some(Value::Bool(true)),
+            ("false", "Non") => Some(Value::Bool(false)),
+            _ => None,
+        };
+    }
+    let options: &[(&str, &str, &str)] = match name {
+        "fuel" => &[
+            ("1", "Essence", "Essence"),
+            ("2", "Diesel", "Diesel"),
+            ("6", "Hybride", "Hybride"),
+            ("8", "Hybride Rechargeable", "Hybride rechargeable"),
+        ],
+        "gearbox" => &[
+            ("1", "Manuelle", "Manuelle"),
+            ("2", "Automatique", "Automatique"),
+        ],
+        "body" => &[
+            ("berline", "Berline", "Berline"),
+            ("citadine", "Citadine", "Citadine"),
+            ("break", "Break", "Break"),
+            (
+                "4x4",
+                "4x4, SUV, Crossover & Pick-up",
+                "SUV, 4x4 et pick-up",
+            ),
+            ("coupe", "Coupé", "Coupé"),
+            ("cabriolet", "Cabriolet", "Cabriolet"),
+            ("autre", "Autre", "Autre"),
+        ],
+        "upholstery" => &[
+            ("all_leather", "Tout cuir", "Tout cuir"),
+            ("fabric", "Tissu", "Tissu"),
+            ("partial_leather", "Cuir partiel", "Cuir partiel"),
+        ],
+        "color" => {
+            const COLORS: &[&str] = &[
+                "Argent", "Beige", "Blanc", "Bleu", "Bordeaux", "Gris", "Jaune", "Marron", "Noir",
+                "Orange", "Rose", "Rouge", "Vert", "Violet", "Autre",
+            ];
+            return COLORS
+                .iter()
+                .find(|color| code.eq_ignore_ascii_case(color) && label == **color)
+                .map(|color| Value::from(*color));
+        }
+        _ => return None,
+    };
+    options
+        .iter()
+        .find(|(source_code, source_label, _)| {
+            code == *source_code && label.eq_ignore_ascii_case(source_label)
+        })
+        .map(|(_, _, canonical)| Value::from(*canonical))
+}
+
+fn listed_option(
+    codes: &[Value],
+    labels: &str,
+    required: &str,
+    options: &[(&str, &str)],
+) -> Option<Value> {
+    if codes.len() > options.len() {
+        return None;
+    }
+    let mut labels = labels.split(", ");
+    let mut seen = HashSet::new();
+    for value in codes {
+        let code = value.as_str()?;
+        let label = labels.next()?;
+        if !seen.insert(code) || !options.contains(&(code, label)) {
+            return None;
+        }
+    }
+    (labels.next().is_none() && seen.contains(required)).then_some(Value::Bool(true))
+}
